---
import { quests } from '../data/profile';
---

<section id="quetes" class="wrap section" aria-labelledby="quetes-title">
  <h2 id="quetes-title" class="section-title">Quêtes <span class="tag bg-red">Projets</span></h2>
  <div class="grid">
    {
      quests.map((q) => (
        <article class="box lift">
          <header class={`bg-${q.color}`}>
            <h3>{q.name}</h3>
            <span class="tag">{q.status}</span>
          </header>
          <div class="body">
            <p class="pitch">{q.pitch}</p>
            <ul class="details">
              {q.details.map((d) => <li>{d}</li>)}
            </ul>
            <ul class="stack" aria-label="Technologies">
              {q.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
  article {
    overflow: hidden;
  }
  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.25rem;
    border-bottom: var(--border);
  }
  h3 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .body {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }
  .pitch {
    font-size: 1.25rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .details {
    display: grid;
    gap: 0.375rem;
  }
  .details li::before {
    content: '▸ ';
    font-weight: 700;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
