---
import { profile } from '../data/profile';
---

<footer class="wrap">
  <div class="box cta bg-yellow">
    <p class="tag">Continue ?</p>
    <h2>On joue ensemble ?</h2>
    <p>Un projet, une idée ou juste envie d'échanger : écris-moi sur LinkedIn.</p>
    <div class="btns">
      <a class="btn" href={profile.linkedin} rel="me">LinkedIn ↗</a>
      <a class="btn" href={profile.github} rel="me">GitHub ↗</a>
    </div>
  </div>
  <p class="small">
    © {new Date().getFullYear()} {profile.name} · Fait avec Astro ·
    <span class="hint">Psst : ↑ ↑ ↓ ↓ ← → ← → B A</span>
  </p>
  <p class="sr-only" role="status" id="konami-status"></p>
</footer>

<script>
  // Code Konami : bascule le « mode turbo ».
  const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let pos = 0;
  addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() === code[pos].toLowerCase()) pos++;
    else if (e.key === 'ArrowUp') pos = pos === 2 ? 2 : 1; // « ↑ ↑ ↑ » garde les deux derniers
    else pos = 0;
    if (pos < code.length) return;
    pos = 0;
    const on = document.documentElement.classList.toggle('turbo');
    document.getElementById('konami-status')!.textContent = on ? 'Mode turbo activé : +30 vies !' : 'Mode turbo désactivé.';
  });
</script>

<style>
  footer {
    padding-block: 2rem 3rem;
  }
  .cta {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.5rem, 5vw, 3rem);
  }
  h2 {
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn {
    padding: 0.75rem 1.25rem;
    background: var(--ink);
    color: var(--paper);
    border: var(--border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0.25rem 0.25rem 0 var(--red);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn:hover {
    transform: translate(-0.125rem, -0.125rem);
    box-shadow: 0.375rem 0.375rem 0 var(--red);
  }
  .small {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
